# =============================================================================
# CyberLearn Frontend Production Environment Configuration Template
# =============================================================================

# Backend API Base URL (Point to your deployed FastAPI backend)
# Local development: http://localhost:5000
# Production: https://your-cyberlearn-api.onrender.com
VITE_API_URL=http://localhost:5000

# Google OAuth Client ID for User Authentication
# Obtain from Google Cloud Console > APIs & Services > Credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

