# Google Gemini API Key from https://aistudio.google.com/
# Leave empty for mock mode development
VITE_GEMINI_API_KEY=

# Google OAuth Client ID for Authentication
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Authentication API Settings (Example for future backend)
# Replace with your actual backend URL when ready (e.g., Firebase, Supabase, or Custom Node.js)
VITE_AUTH_API_URL=https://api.cyberdaksh.com/v1/auth
VITE_AUTH_API_KEY=
