# =============================================================================
# CyberLearn Backend Environment Configuration Template
# =============================================================================

# Groq LLM API Key (Required for RAG / Open-ended Assistant queries)
GROQ_API_KEY=your_production_groq_api_key_here

# Groq Production Model Identifier (Default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Database Connection URL (PostgreSQL in production, SQLite fallback in local dev)
# Example: postgresql://postgres_user:secure_password@db_host:5432/cyberlearn
DATABASE_URL=sqlite:///./cyberlearn.db

# JWT Secret Key for cryptographic token signing (Generate using `openssl rand -hex 32`)
JWT_SECRET_KEY=your_production_jwt_secret_key_here

# Frontend Application URLs for CORS (comma-separated if multiple domains)
FRONTEND_URL=https://your-cyberlearn-frontend.onrender.com,http://localhost:5173

# Backend Service Port (Default: 5000)
PORT=5000

# RAG Retrieval Configuration
TOP_K_RETRIEVAL=15
TOP_K_CONTEXT=4
MIN_RELEVANCE_SCORE=2.5

